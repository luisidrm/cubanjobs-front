NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SuperTokens core — same instance the Express API (back/) points at.
# Lets proxy.ts verify a session's JWT locally, without a round-trip to the API.
SUPERTOKENS_CORE_URL=http://localhost:43567
SUPERTOKENS_API_KEY=

# Stripe is hidden for now. Set to true at build time to show Stripe checkout and the billing portal.
NEXT_PUBLIC_STRIPE_ENABLED=false
